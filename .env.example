# Copy to .env for local development. NEVER commit a real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset to use local SQLite, or point at Postgres:
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
# Booking rules
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_MAX_ADVANCE_DAYS=90
# Demo seeding (synthetic data only)
DEMO_STAFF_PASSWORD=
DEMO_PATIENT_PASSWORD=
